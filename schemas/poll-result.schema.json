{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:getty:schema:poll-result:v1",
  "title": "getty Poll Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "poll"],
  "properties": {
    "schema": { "const": "getty.poll-result.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "poll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "winnerOptionId", "winnerOptionLabel", "winnerVotes", "totalVotes", "isTie", "endedAt", "winnerColor", "reason", "options"],
      "properties": {
        "question": { "type": "string" },
        "winnerOptionId": { "type": ["string", "null"] },
        "winnerOptionLabel": { "type": "string" },
        "winnerVotes": { "type": "number" },
        "totalVotes": { "type": "number" },
        "isTie": { "type": "boolean" },
        "endedAt": { "type": "number" },
        "winnerColor": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "votes"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "votes": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
